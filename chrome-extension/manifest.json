{
  "manifest_version": 3,
  "name": "Aether Pulse — AI Harness Liquid Telemetry Overlay",
  "version": "1.0.0",
  "description": "Draggable liquid-physics telemetry overlay for Claude Code, Google Antigravity, and OpenAI Codex CLI with 1-click harness switching.",
  "author": "Eloquent (@mjeanhudson-dev)",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Aether Pulse Liquid Telemetry",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://mjeanhudson-dev.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mjeanhudson-dev.github.io/*",
        "https://github.com/*",
        "https://gist.github.com/*",
        "https://www.viberank.app/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://aistudio.google.com/*",
        "https://gemini.google.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "css": ["content-overlay.css"],
      "js": ["content-overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
